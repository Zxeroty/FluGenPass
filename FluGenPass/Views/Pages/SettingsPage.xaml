<Page x:Class="FluGenPass.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Loaded="OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Card Margin="0,0,0,24">
            <StackPanel Margin="28">
                <TextBlock FontSize="30"
                           FontWeight="SemiBold"
                           Text="{DynamicResource SettingsTitle}" />
                <TextBlock Margin="0,10,0,20"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{DynamicResource SettingsSubtitle}"
                           TextWrapping="Wrap" />

                <TextBlock FontWeight="SemiBold"
                           Text="{DynamicResource SettingsThemeTitle}" />
                <ComboBox Width="240"
                          Margin="0,12,0,0"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Grid.Row="1"
                 Margin="0,0,0,24">
            <StackPanel Margin="28">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="{DynamicResource SettingsAutoLockTitle}" />
                <TextBlock Margin="0,10,0,18"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{DynamicResource SettingsAutoLockSubtitle}"
                           TextWrapping="Wrap" />

                <ui:ToggleSwitch Margin="0,0,0,12"
                              IsChecked="{Binding AutoLockEnabled}"
                              Content="{DynamicResource SettingsAutoLockSwitch}" />

                <StackPanel Margin="0,8,0,0"
                            IsEnabled="{Binding AutoLockEnabled}">
                    <TextBlock FontWeight="SemiBold"
                               Text="{DynamicResource SettingsAutoLockAfter}" />
                    <ComboBox Width="180"
                               Margin="0,8,0,0"
                               ItemsSource="{Binding AutoLockTimeoutOptions}"
                               SelectedItem="{Binding AutoLockTimeoutMinutes}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{DynamicResource SettingsAutoLockMinutes}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Grid.Row="2"
                 Margin="0,0,0,24">
            <StackPanel Margin="28">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="{DynamicResource SettingsVaultAccessTitle}" />
                <TextBlock Margin="0,10,0,18"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding VaultAccessDescription}"
                           TextWrapping="Wrap" />

                <WrapPanel>
                    <ui:Button Margin="0,0,12,12"
                               Command="{Binding ConfigureMasterPasswordCommand}"
                               Content="{Binding PrimaryVaultPasswordActionLabel}"
                               Icon="{ui:SymbolIcon Symbol=Key24}" />
                    <ui:Button Margin="0,0,0,12"
                               Appearance="Danger"
                               Command="{Binding ResetVaultProtectionCommand}"
                               Content="{DynamicResource SettingsVaultBtnReset}"
                               Icon="{ui:SymbolIcon Symbol=Delete24}"
                               Visibility="{Binding HasMasterPassword, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </WrapPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Grid.Row="3"
                 Margin="0,0,0,24">
            <StackPanel Margin="28">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="{DynamicResource SettingsStorageTitle}" />
                <TextBlock Margin="0,10,0,18"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{DynamicResource SettingsStorageSubtitle}"
                           TextWrapping="Wrap" />

                <TextBlock FontWeight="SemiBold"
                           Text="{DynamicResource SettingsPathAppData}" />
                <Border Margin="0,8,0,0"
                        Padding="12,10"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{Binding AppDirectory}"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Margin="0,16,0,0"
                           FontWeight="SemiBold"
                           Text="{DynamicResource SettingsPathSettings}" />
                <Border Margin="0,8,0,0"
                        Padding="12,10"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{Binding SettingsFilePath}"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Margin="0,16,0,0"
                           FontWeight="SemiBold"
                           Text="{DynamicResource SettingsPathVault}" />
                <Border Margin="0,8,0,0"
                        Padding="12,10"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{Binding VaultFilePath}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ui:Card>

        <ui:Card Grid.Row="4"
                 Margin="0,0,0,24">
            <StackPanel Margin="28">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="{DynamicResource SettingsSecurityTitle}" />
                <TextBlock Margin="0,10,0,18"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{DynamicResource SettingsSecuritySubtitle}"
                           TextWrapping="Wrap" />

                <TextBlock FontWeight="SemiBold"
                           Text="{DynamicResource SettingsKeyFileTitle}" />
                <TextBlock Margin="0,8,0,12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding KeyFileDescription}"
                           TextWrapping="Wrap" />
                <ui:ToggleSwitch Margin="0,0,0,12"
                                 IsChecked="{Binding IsKeyFileEnabled}"
                                 Content="{DynamicResource SettingsKeyFileSwitch}" />
                <ui:Button Width="180"
                           Margin="0,0,0,18"
                           Command="{Binding RegenerateKeyFileCommand}"
                           Content="{DynamicResource SettingsKeyFileBtnRegenerate}"
                           Icon="{ui:SymbolIcon Symbol=Key24}"
                           Visibility="{Binding IsKeyFileEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ui:Button Width="180"
                           Command="{Binding LockVaultCommand}"
                           Content="{DynamicResource CommonBtnLock}"
                           Icon="{ui:SymbolIcon Symbol=LockClosed24}"
                           Visibility="{Binding IsVaultUnlocked, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Grid.Row="5">
            <StackPanel Margin="28">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="{DynamicResource SettingsLanguageTitle}" />
                <TextBlock Margin="0,10,0,18"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{DynamicResource SettingsLanguageSubtitle}"
                           TextWrapping="Wrap" />

                <ComboBox Width="240"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguage}" />
            </StackPanel>
        </ui:Card>
    </Grid>
</Page>
