<Page x:Class="FluGenPass.Views.Pages.VaultPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      UseLayoutRounding="True"
      mc:Ignorable="d"
      Loaded="OnLoaded">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="24"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:Card Margin="0,0,0,24">
            <Grid Margin="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock FontSize="30"
                               FontWeight="SemiBold"
                               Text="{DynamicResource VaultTitle}" />
                    <TextBlock Margin="0,10,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding Headline}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top">
                    <!-- Refresh Button -->
                    <ui:Button Margin="0,0,12,12"
                               Command="{Binding RefreshCommand}"
                               Content="{DynamicResource VaultBtnRefresh}"
                               Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" />
                    
                    <!-- Import & Export Dropdown -->
                    <ui:DropDownButton Margin="0,0,12,12"
                                       Content="{DynamicResource VaultBtnImport}"
                                       Icon="{ui:SymbolIcon Symbol=ArrowUpload24}"
                                       Visibility="{Binding IsVaultUnlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Command="{Binding ImportPasswordsCommand}"
                                          Header="{DynamicResource VaultBtnImport}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowUpload24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Command="{Binding ExportSecureCommand}"
                                          Header="{DynamicResource VaultBtnExportBackup}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="SaveArrowRight20" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding ExportBitwardenCsvCommand}"
                                          Header="{DynamicResource VaultBtnExportCsv}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="DocumentArrowRight24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <!-- Verify File Button -->
                    <ui:Button Margin="0,0,0,12"
                               Command="{Binding VerifyTransferFileCommand}"
                               Content="{DynamicResource VaultBtnVerify}"
                               Icon="{ui:SymbolIcon Symbol=ShieldCheckmark24}" />
                </WrapPanel>
            </Grid>
        </ui:Card>

        <ui:Card Grid.Row="1">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource VaultFilterLabel}" />
                        <ComboBox Width="220"
                                  ItemsSource="{Binding AvailableTags}"
                                  SelectedItem="{Binding SelectedTagFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <ui:TextBox Grid.Column="2"
                                Width="300"
                                Icon="{ui:SymbolIcon Symbol=Search24}"
                                ClearButtonEnabled="True"
                                PlaceholderText="{DynamicResource VaultSearchPlaceholder}"
                                Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <DataGrid x:Name="EntriesDataGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Entries}"
                          MinHeight="300"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          Background="{DynamicResource ControlFillColorSecondaryBrush}"
                          BorderBrush="Transparent"
                          BorderThickness="0"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          RowBackground="Transparent"
                          AlternatingRowBackground="Transparent"
                          RowHeight="34"
                          HorizontalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                          VerticalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                          ClipboardCopyMode="None"
                          PreviewMouseRightButtonDown="OnEntriesDataGridPreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu SnapsToDevicePixels="True"
                                     TextOptions.TextFormattingMode="Display"
                                     TextOptions.TextRenderingMode="ClearType"
                                     UseLayoutRounding="True">
                            <MenuItem Header="{DynamicResource VaultCtxCopySite}"
                                      Command="{Binding CopySiteNameCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Copy24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource VaultCtxCopyPassword}"
                                      Command="{Binding CopyEntryCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Copy24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding RevealButtonText}"
                                      Command="{Binding ToggleRevealCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Eye24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource VaultCtxCheckCompromised}"
                                      Command="{Binding CheckPwnedCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="ShieldError24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource VaultCtxCopyLink}"
                                      Command="{Binding CopyUrlCommand}"
                                      IsEnabled="{Binding HasUrl}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Copy24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource VaultCtxOpenLink}"
                                      Command="{Binding OpenUrlCommand}"
                                      IsEnabled="{Binding HasUrl}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="OpenFolder24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{DynamicResource VaultCtxEditDetails}"
                                      Command="{Binding EditDetailsCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Edit24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource VaultCtxEditTags}"
                                      Command="{Binding EditTagsCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Tag24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource VaultCtxClone}"
                                      Command="{Binding CloneEntryCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="DocumentCopy24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{DynamicResource VaultCtxDelete}"
                                      Command="{Binding DeleteEntryCommand}"
                                      Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Delete24"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="MinHeight" Value="34" />
                            <Setter Property="ValidationErrorTemplate" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="1.4*"
                                                Header="{DynamicResource VaultColSite}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SiteName}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1.6*"
                                                Header="{DynamicResource VaultColLink}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Url}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource SystemAccentColorBrush}"
                                               Cursor="Hand"
                                               Visibility="{Binding HasUrl, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenUrlCommand}" />
                                        </TextBlock.InputBindings>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="TextDecorations" Value="Underline" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1.25*"
                                                Header="{DynamicResource VaultColPassword}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Cascadia Code"
                                               Text="{Binding PasswordDisplay}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1.25*"
                                                Header="{DynamicResource VaultColTags}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="-"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTags}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Tags}"
                                                      Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,4,4"
                                                            Padding="6,3"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                            BorderBrush="{DynamicResource SystemAccentColorBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                   Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="170"
                                                Header="{DynamicResource VaultColCreated}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreatedUtc, StringFormat={}{0:g}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="12"
                           Text="{DynamicResource VaultRightClickHint}" />
            </Grid>
        </ui:Card>
    </Grid>
</Page>
