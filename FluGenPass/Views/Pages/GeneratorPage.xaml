<Page x:Class="FluGenPass.Views.Pages.GeneratorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <ui:Card Margin="0,0,24,24">
                <StackPanel Margin="28">
                    <TextBlock FontSize="30"
                               FontWeight="SemiBold"
                               Text="Password Generator" />
                    <TextBlock Margin="0,8,0,20"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Create a fresh credential with cryptographic randomness, then copy it or send it straight into the local vault."
                               TextWrapping="Wrap" />

                    <TextBox MinHeight="92"
                             Padding="16"
                             FontFamily="Cascadia Code"
                             FontSize="24"
                             IsReadOnly="True"
                             Text="{Binding GeneratedPassword}" />

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding StrengthLabel, StringFormat=Strength: {0}}" />
                            <ProgressBar Margin="0,10,0,0"
                                         Height="10"
                                         Maximum="100"
                                         Value="{Binding StrengthPercent}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="24,0,0,0"
                                    HorizontalAlignment="Right">
                            <TextBlock FontSize="22"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Text="{Binding EntropyBits, StringFormat={}{0} bits}" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       Text="Estimated entropy" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,16,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />

                    <WrapPanel Margin="0,24,0,0">
                        <ui:Button Margin="0,0,12,12"
                                   Appearance="Primary"
                                   Command="{Binding GeneratePasswordCommand}"
                                   Content="Generate"
                                   Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" />
                        <ui:Button Margin="0,0,12,12"
                                   Command="{Binding CopyToClipboardCommand}"
                                   Content="Copy"
                                   Icon="{ui:SymbolIcon Symbol=Copy24}" />
                        <ui:Button Margin="0,0,12,12"
                                   Command="{Binding SaveToVaultCommand}"
                                   Content="Save to Vault"
                                   Icon="{ui:SymbolIcon Symbol=Save24}" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Grid.Column="1"
                     Margin="0,0,0,24">
                <StackPanel Margin="28">
                    <TextBlock FontSize="26"
                               FontWeight="SemiBold"
                               Text="Options" />
                    <TextBlock Margin="0,8,0,22"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="The password refreshes immediately as you tune length and character sets."
                               TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold"
                                   Text="Length" />
                        <TextBlock Grid.Column="1"
                                   FontWeight="SemiBold"
                                   Text="{Binding Length}" />
                    </Grid>

                    <Slider Minimum="8"
                            Maximum="64"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Length}" />

                    <CheckBox Margin="0,24,0,0"
                              Content="Uppercase letters"
                              IsChecked="{Binding IncludeUppercase}" />
                    <CheckBox Margin="0,12,0,0"
                              Content="Lowercase letters"
                              IsChecked="{Binding IncludeLowercase}" />
                    <CheckBox Margin="0,12,0,0"
                              Content="Numbers"
                              IsChecked="{Binding IncludeNumbers}" />
                    <CheckBox Margin="0,12,0,0"
                              Content="Special symbols"
                              IsChecked="{Binding IncludeSymbols}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Grid.Row="1"
                     Grid.ColumnSpan="2">
                <Grid Margin="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Weak" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Below 45 bits. Fine for throwaway use, not for accounts you care about."
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="16,0">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Medium" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Between 45 and 69 bits. Better, but still worth increasing for long-term credentials."
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="16,0,0,0">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Strong" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="70 bits and above. This is the sweet spot for the passwords you keep."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </ScrollViewer>
</Page>