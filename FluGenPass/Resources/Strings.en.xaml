    <!-- Generator Page -->
    <sys:String x:Key="GenTitle">Password Generator</sys:String>
    <sys:String x:Key="GenSubtitle">Create a fresh credential with cryptographic randomness, then copy it or send it straight into the local vault.</sys:String>
    <sys:String x:Key="GenStrength">Strength: {0}</sys:String>
    <sys:String x:Key="GenEntropy">Estimated entropy</sys:String>
    <sys:String x:Key="GenBits">{0} bits</sys:String>
