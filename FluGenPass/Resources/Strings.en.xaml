    <sys:String x:Key="GenBtnCopy">Copy</sys:String>
    <sys:String x:Key="GenBtnSave">Save to Vault</sys:String>
    <sys:String x:Key="GenOptionsTitle">Options</sys:String>
    <sys:String x:Key="GenOptionsSubtitle">The password refreshes immediately as you tune length and character sets.</sys:String>
    <sys:String x:Key="GenOptionLength">Length</sys:String>
    <sys:String x:Key="GenOptionUpper">Uppercase letters</sys:String>
    <sys:String x:Key="GenOptionLower">Lowercase letters</sys:String>
    <sys:String x:Key="GenOptionNumbers">Numbers</sys:String>
    <sys:String x:Key="GenOptionSymbols">Special symbols</sys:String>
    <sys:String x:Key="GenWeakTitle">Weak</sys:String>
    <sys:String x:Key="GenWeakDesc">Below 45 bits. Fine for throwaway use, not for accounts you care about.</sys:String>
    <sys:String x:Key="GenMediumTitle">Medium</sys:String>
    <sys:String x:Key="GenMediumDesc">Between 45 and 69 bits. Better, but still worth increasing for long-term credentials.</sys:String>
    <sys:String x:Key="GenStrongTitle">Strong</sys:String>
    <sys:String x:Key="GenStrongDesc">70 bits and above. This is the sweet spot for the passwords you keep.</sys:String>
