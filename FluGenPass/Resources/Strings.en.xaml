    <!-- Settings Page -->
    <sys:String x:Key="SettingsTitle">Settings</sys:String>
    <sys:String x:Key="SettingsSubtitle">Tune theme behavior and review where FluGenPass keeps its local settings and encrypted vault.</sys:String>
    <sys:String x:Key="SettingsPersonalizationTitle">Personalization</sys:String>
    <sys:String x:Key="SettingsThemeTitle">Theme</sys:String>
    <sys:String x:Key="SettingsAutoLockTitle">Auto-Lock</sys:String>
    <sys:String x:Key="SettingsAutoLockSubtitle">Automatically lock the vault after a period of inactivity. Keyboard and mouse activity resets the timer.</sys:String>
    <sys:String x:Key="SettingsAutoLockSwitch">Auto-lock after inactivity</sys:String>
    <sys:String x:Key="SettingsAutoLockAfter">Lock after</sys:String>
    <sys:String x:Key="SettingsAutoLockMinutes">Minutes of inactivity</sys:String>
    <sys:String x:Key="SettingsVaultAccessTitle">Vault Access</sys:String>
    <sys:String x:Key="SettingsVaultBtnReset">Reset Vault Protection</sys:String>
    <sys:String x:Key="SettingsVaultBtnCreate">Create Master Password</sys:String>
    <sys:String x:Key="SettingsVaultBtnChange">Change Master Password</sys:String>
    <sys:String x:Key="SettingsVaultDescUnlocked">The vault is unlocked for this session. You can update the master password or fully reset vault protection.</sys:String>
    <sys:String x:Key="SettingsVaultDescLocked">A master password is configured. Unlock the vault first if you want to change the password without clearing saved entries.</sys:String>
    <sys:String x:Key="SettingsVaultDescNone">No master password is configured yet. Create one to protect access to the vault page.</sys:String>
    <sys:String x:Key="SettingsStorageTitle">Storage</sys:String>
    <sys:String x:Key="SettingsStorageSubtitle">Everything stays local in your Windows profile. Vault exports and imports stay local too, with SHA-256 integrity checks and ECDSA digital signatures for transfer files.</sys:String>
    <sys:String x:Key="SettingsPathAppData">App data folder</sys:String>
    <sys:String x:Key="SettingsPathSettings">Settings file</sys:String>
    <sys:String x:Key="SettingsPathVault">Encrypted vault file</sys:String>
    <sys:String x:Key="SettingsSecurityTitle">Security</sys:String>
    <sys:String x:Key="SettingsSecuritySubtitle">The vault unlocks only for the current app session. Locking clears the in-memory key and keeps the encrypted file on disk.</sys:String>
    <sys:String x:Key="SettingsKeyFileTitle">Key File</sys:String>
    <sys:String x:Key="SettingsKeyFileDescDisabled">Generate a local key file if you want the vault to require a second unlock step after the master password.</sys:String>
    <sys:String x:Key="SettingsKeyFileDescEnabled">Two-step unlock is enabled. After the master password, this vault also requires the key file: {0}</sys:String>
